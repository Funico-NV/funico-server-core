{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:funico:service-definition:1",
  "title": "Funico service definition, schema 1",
  "description": "Editor assistance. ServerCore ServiceDefinition.decode is the authoritative security validator; limits in Swift use UTF-8 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "service",
    "displayName",
    "profile",
    "platforms"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "service": {
      "type": "string",
      "pattern": "^[a-z0-9](?!.*\\.\\.)[a-z0-9._-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9](?!.*\\.\\.)[a-z0-9._-]{0,63}$"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/runtime"
      }
    },
    "environment": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/setting"
      }
    },
    "requiresMigration": {
      "type": "boolean",
      "default": false
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "path"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "maxLength": 257,
          "pattern": "^/(?:(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)*)?$"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "default": 60
        },
        "stableSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 10
        }
      }
    }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "executable"
      ],
      "properties": {
        "os": {
          "enum": [
            "linux",
            "macos"
          ]
        },
        "arch": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "executable": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)*$"
        },
        "arguments": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "type",
        "required",
        "secret"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]{0,127}$",
          "description": "Runtime injection/control names are additionally refused by the Swift validator."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "help": {
          "type": "string",
          "maxLength": 2000
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean",
            "url"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        },
        "defaultValue": {
          "type": "string",
          "maxLength": 8192,
          "description": "Non-secret text only; validated against the selected type by Swift."
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "minimum": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maximum": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "secret": {
                "const": true
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "defaultValue"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "const": "integer"
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "const": "string"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "choices"
              ]
            }
          }
        }
      ]
    }
  },
  "examples": [
    {
      "schema": 1,
      "service": "example",
      "displayName": "Example service",
      "profile": "application",
      "platforms": [
        {
          "os": "linux",
          "arch": "x86_64",
          "executable": "bin/Example",
          "arguments": [
            "serve",
            "--hostname",
            "127.0.0.1",
            "--port",
            "8080"
          ]
        }
      ],
      "requiresMigration": false,
      "readiness": {
        "port": 8080,
        "path": "/health",
        "timeoutSeconds": 60,
        "stableSeconds": 10
      },
      "environment": [
        {
          "name": "PUBLIC_URL",
          "title": "Public endpoint",
          "type": "url",
          "required": true,
          "secret": false
        },
        {
          "name": "LOG_LEVEL",
          "title": "Log level",
          "type": "string",
          "required": false,
          "secret": false,
          "defaultValue": "info",
          "choices": [
            "debug",
            "info",
            "warning",
            "error"
          ]
        },
        {
          "name": "API_TOKEN",
          "title": "Upstream API token",
          "type": "string",
          "required": true,
          "secret": true
        }
      ]
    }
  ]
}
